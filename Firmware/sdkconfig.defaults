# ESP32-CAM (AI-Thinker) — 4 MB flash, 4 MB PSRAM

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM — OV2640 frames go here, reduces pressure on internal heap
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM32=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# No Bluetooth needed for camera
CONFIG_BT_ENABLED=n

# HTTP server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# Disable IPv6 to save memory
CONFIG_LWIP_IPV6=n

# Socket table: httpd(1+7) + mjpeg_srv(1+1) = 10 at peak — set headroom to 16
# so accept() doesn't fail with ENFILE under burst connections.
CONFIG_LWIP_MAX_SOCKETS=16

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Compiler — optimise for speed; binary is ~1 MB with 49% partition headroom
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Coredump to flash (useful for debugging camera issues)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# CPU — 240 MHz gives 50% more throughput for TCP/memcpy vs 160 MHz
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240

# WiFi interrupt handlers in IRAM → lower TX/RX interrupt latency
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# lwIP hot paths in IRAM — reduces cache misses on every TCP send(), which
# is called once per MJPEG frame (~12-20 times/second).
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# lwIP task pinned to core 1 so it runs in parallel with mjpeg_task (core 0).
# Without affinity, LwIP can land on core 0 and time-share with mjpeg_task.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# lwIP TCP window — SVGA JPEGs at quality 12 can reach 40-60 KB; 64 KB window
# lets a full frame be in-flight without waiting for an ACK round-trip.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535

# Disable brownout detector — AI-Thinker ESP32-CAM voltage regulator has
# marginal headroom when WiFi TX + I2S DMA + PSRAM run simultaneously.
# Fix properly with a 5V/2A supply; keep this disabled for stability.
CONFIG_ESP_BROWNOUT_DET=n
